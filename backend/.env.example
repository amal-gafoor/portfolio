# Any OpenAI-compatible chat API with tool calling (Groq, OpenAI, Gemini, OpenRouter...).
# Without LLM_API_KEY the agent runs in demo mode: retrieval + tools, no generated answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Comma-separated sites allowed to call this API (your deployed frontend). localhost is always allowed.
FRONTEND_ORIGINS=
